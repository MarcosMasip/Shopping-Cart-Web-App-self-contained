#############################################
# Root Environment Example
# Copy to .env (root) and adjust as needed.
#############################################

# Frontend build will use this (falls back to http://localhost:8080)
VITE_API_BASE=http://localhost:8080

# Demo basic auth credentials (seeded in user-service data.sql)
DEMO_USERNAME=demo
DEMO_PASSWORD=demo

# Ports (adjust if conflicts)
DISCOVERY_PORT=8084
GATEWAY_PORT=8080
INVENTORY_PORT=8081
USER_PORT=8082
CART_PORT=8083
FRONTEND_DEV_PORT=5173

# Toggle docker mode in run script (future enhancement)
DOCKER_MODE=false  # Set to true to prefer Docker/Compose in run scripts
