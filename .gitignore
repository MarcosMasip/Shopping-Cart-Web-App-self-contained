# Root ignore to prevent accidental commits of build artifacts and dependencies

# Node / frontend
frontend/node_modules/
frontend/dist/
**/node_modules/

# Java build output
**/target/
# Occasionally stray build directories with trailing space were generated; ignore them too
**/target */


# OS / IDE
.DS_Store
.idea/
.vscode/

# Logs & env
*.log
.env
logs/

# Maven wrapper jars are already allowed inside each service .gitignore

# Misc
Thumbs.db
# Ignore built frontend static assets
api-gateway/src/main/resources/static/

# H2 database files (per-service persistent dev data)
inventory-service/data/
user-service/data/
cart-service/data/
api-gateway/data/
discovery-service/data/

# Root-level aggregated H2 databases created by run.sh (do not commit)
data/
